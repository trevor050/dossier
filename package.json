{
  "name": "@trevor050/dossier",
  "version": "0.2.0",
  "description": "Self-hosted, person-level analytics for small sites: see who opened the link you sent, what they looked at, and whether they came back.",
  "keywords": [
    "analytics",
    "self-hosted",
    "session-replay",
    "postgres",
    "vercel",
    "portfolio"
  ],
  "license": "MIT",
  "author": "trevor050",
  "homepage": "https://github.com/trevor050/dossier#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trevor050/dossier.git"
  },
  "bugs": "https://github.com/trevor050/dossier/issues",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "bin": {
    "dossier": "./dist/cli/index.js"
  },
  "exports": {
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./vercel/collect": {
      "types": "./dist/vercel/collect.d.ts",
      "default": "./dist/vercel/collect.js"
    },
    "./vercel/replay": {
      "types": "./dist/vercel/replay.d.ts",
      "default": "./dist/vercel/replay.js"
    },
    "./vercel/admin": {
      "types": "./dist/vercel/admin.d.ts",
      "default": "./dist/vercel/admin.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "node scripts/build-assets.mjs && tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
    "build:assets": "node scripts/build-assets.mjs",
    "typecheck": "node scripts/build-assets.mjs --if-missing && tsc -p tsconfig.json --noEmit",
    "test": "node scripts/build-assets.mjs --if-missing && vitest run",
    "demo": "npm run build && node dist/cli/index.js demo",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "dependencies": {
    "pg": "^8.23.1"
  },
  "optionalDependencies": {
    "@electric-sql/pglite": "^0.5.16"
  },
  "devDependencies": {
    "@fingerprintjs/fingerprintjs": "^5.3.0",
    "@rrweb/record": "^2.2.2",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "d3-geo": "^3.1.2",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "playwright-core": "^1.65.0",
    "preact": "^11.2.0",
    "rrweb-player": "^2.2.2",
    "topojson-client": "^3.1.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12",
    "world-atlas": "^2.0.2"
  }
}
