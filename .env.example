# Required
DATABASE_URL=postgres://user:password@host:5432/dossier
# At least 16 characters. Generate one with: npx dossier token
DOSSIER_ADMIN_TOKEN=

# Optional: other hosts allowed to post events cross-origin (comma-separated)
DOSSIER_ALLOWED_HOSTS=

# Optional IP enrichment. All off by default except reverse DNS. See README.
IPINFO_TOKEN=
IPINFO_API=lite
DOSSIER_IPWHOIS=0
DOSSIER_PTR=1

# Optional tuning
BOT_SCORE_THRESHOLD=6
DOSSIER_LINK_THRESHOLD=0.5
DOSSIER_REPLAY_MAX_MB=5
